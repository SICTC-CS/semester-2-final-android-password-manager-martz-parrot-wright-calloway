<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#F4E6F6"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    android:id="@+id/acount_card_layout">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Indicator Bar (Used for color coding in Java) -->
        <View
            android:id="@+id/vIndicator"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="#323232"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Principal Suspect (Vendor) -->
        <TextView
            android:id="@+id/tvService"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="STARBUCKS ACOUNT"
            android:textColor="?attr/colorSecondary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            app:layout_constraintStart_toEndOf="@id/vIndicator"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvCatagory"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/tvCatagory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:text="Cafe"
            android:textColor="?attr/colorSecondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            app:layout_constraintStart_toEndOf="@id/tvService"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="8dp"/>

        <!-- Date of Incident -->
        <TextView
            android:id="@+id/tvRowDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="DATE: 10/24/2023"
            android:textColor="?attr/colorSecondary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            app:layout_constraintTop_toBottomOf="@id/tvService"
            app:layout_constraintStart_toEndOf="@id/vIndicator"
            android:layout_marginTop="4dp"/>
        <Button
            android:id="@+id/tvURL"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="12dp"
            android:backgroundTint="#098E83"
            android:text="Visit Site"
            android:textColor="#000000"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvRowDate"
            app:layout_constraintStart_toEndOf="@id/vIndicator"
            android:layout_marginTop="4dp"/>
        <!-- Financial Impact (Amount) -->
        <TextView
            android:id="@+id/tvRowAmount"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-$5.75 per Time"
            android:textColor="#CF6679"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>