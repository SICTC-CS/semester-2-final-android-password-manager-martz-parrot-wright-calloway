<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#424242"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:id="@+id/acount_card_layout">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <View
            android:id="@+id/vIndicator"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="#fd7000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvService"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="SERVICE NAME"
            android:textColor="#fd7000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintStart_toEndOf="@id/vIndicator"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvCatagory"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvCatagory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Work"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:alpha="0.7"
            android:background="#555555"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvRowDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Created: 10/24/2023"
            android:textColor="#BBBBBB"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/tvService"
            app:layout_constraintStart_toEndOf="@id/vIndicator"
            android:layout_marginTop="4dp"/>

        <Button
            android:id="@+id/tvURL"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:backgroundTint="#fd6544"
            android:text="Visit Site"
            android:textColor="#111111"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvRowDate"
            app:layout_constraintStart_toEndOf="@id/vIndicator"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvRowAmount"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$9.99/mo"
            android:textColor="#fd7000"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>